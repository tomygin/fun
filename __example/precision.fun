// ============================================================
// 数字精度 —— Fun 的数字不会骗你
//
// 三层数字塔（自动切换，语法无感知）：
//   int      整数快路径，带溢出检测
//   定点小数  十进制精确小数（0.1 就是精确的 1/10）
//   大有理数  溢出提升 / 无限循环小数的精确兜底
// ============================================================

print("========== 1. 十进制小数是精确的 ==========")

print("0.1 + 0.2      =", 0.1 + 0.2)             // 0.3，不是 0.30000000000000004
print("0.1 + 0.2 == 0.3 ->", 0.1 + 0.2 == 0.3)   // true
print("0.1 * 0.2      =", 0.1 * 0.2)             // 0.02
print("1.1 - 1        =", 1.1 - 1)               // 0.1
print("0.3 - 0.1      =", 0.3 - 0.1)             // 0.2
print("5.5 % 2        =", 5.5 % 2)               // 1.5

// 累加一百万次 0.1，结果精确等于 100000（浮点语言做不到）
s := 0
for i := 0; i < 1000000; i++ { s = s + 0.1 }
print("0.1 累加一百万次 =", s, "，精确吗:", s == 100000)

print("========== 2. 整数永不溢出、永不丢位 ==========")

// float64 只有 53 位尾数,一般语言在 2^53 之后加 1 会被吃掉
print("2^53 + 1       =", 9007199254740992 + 1)          // ...993，精确

// int64 溢出自动提升为大数,永不回绕成负数
big := 9223372036854775807 + 1
print("int64max + 1   =", big)
print("再乘 1000      =", big * 1000)
print("减回去相等吗   :", big - 1 == 9223372036854775807) // true

print("========== 3. 除法：除得尽精确,除不尽也精确 ==========")

print("1 / 4          =", 1 / 4)     // 0.25
print("10 / 2         =", 10 / 2)    // 5
print("1 / 3          =", 1 / 3)     // 打印截断到 20 位小数
// 但内部是精确的有理数 1/3 —— 乘回去分毫不差：
print("1/3 * 3 == 1   ->", 1 / 3 * 3 == 1)      // true

print("========== 4. 归一化：值总停在最简形态 ==========")

print("0.5 + 0.5      =", 0.5 + 0.5)   // 1（自动降回整数）
print("2.50           =", 2.50)        // 2.5
print("1 == 1.0       ->", 1 == 1.0)   // true（跨层精确相等）

print("精度演示结束 ⚖️")
